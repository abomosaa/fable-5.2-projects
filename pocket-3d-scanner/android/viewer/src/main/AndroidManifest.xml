<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The viewer is an OpenGL ES 3.0 renderer. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- AR placement uses the camera through ARCore. AR is optional: devices without ARCore
         get an explanation and the normal 3D viewer. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />

    <application>
        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <!-- Exported models are shared from cache/exports/ through this provider. -->
        <provider
            android:name="dev.pocket3d.viewer.export.ViewerFileProvider"
            android:authorities="${applicationId}.viewer.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/pocket3d_viewer_file_paths" />
        </provider>
    </application>
</manifest>
