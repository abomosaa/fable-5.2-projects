; Range Day — first-person pistol range simulation (Godot 4.7)
config_version=5

[application]
config/name="fpsr-range"
config/description="Range Day: first-person service-pistol shooting range simulation"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=0
boot_splash/show_image=false
boot_splash/bg_color=Color(0.03, 0.03, 0.03, 1)
config/quit_on_go_back=false

[autoload]
Settings="*res://scripts/core/settings.gd"
Controls="*res://scripts/core/controls.gd"
AudioDirector="*res://scripts/audio/audio_director.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[importer_defaults]
wav={"compress/mode": 0, "force/mono": false, "force/max_rate": false, "edit/trim": false, "edit/normalize": false, "edit/loop_mode": 0}

[input_devices]
buffering/agile_event_flushing=true

[layer_names]
3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="target"
3d_physics/layer_4="debris"

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8
common/physics_interpolation=true
jolt_physics_3d/simulation/use_enhanced_internal_edge_removal=true

[audio]
driver/output_latency=10
driver/mix_rate=48000
general/default_playback_type.web=0

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/screen_space_roughness_limiter/enabled=true
anti_aliasing/screen_space_roughness_limiter/amount=0.6
anti_aliasing/screen_space_roughness_limiter/limit=0.32
