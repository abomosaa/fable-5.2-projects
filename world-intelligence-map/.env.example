# World Intelligence Map – configuration
# Copy to .env (never commit it). Everything is optional: without any value the app runs every source that needs no
# credentials. Credentials stay on the server; they are never sent to the browser or written into records.

# ── Server ────────────────────────────────────────────────────────────────────────────────────────────
# live    = fetch real upstream sources (default for `npm start`)
# fixture = replay bundled sample data on a simulated clock (default for `npm run demo`); needs no network
WIM_MODE=live
HOST=127.0.0.1
PORT=8787
# SQLite database file (live mode). Fixture mode always uses a fresh in-memory database.
# WIM_DB_FILE=./data/live.sqlite
# How many sources may be fetched at the same time.
# WIM_INGEST_CONCURRENCY=4
# Comma-separated source ids to switch off, e.g. gdelt-events,ooni
# WIM_DISABLED_SOURCES=
# Comma-separated OPT-IN source ids to switch on. These are off by default because of their terms of use –
# read the licence notes in the Sources panel / docs/SOURCES.md first.   Available: opensky, acled
# WIM_ENABLED_SOURCES=

# ── Optional credentials (a source without its credential is shown as "Not configured" with instructions) ──
# NASA FIRMS active fires – free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# OpenAQ air-quality measurements – free API key: https://explore.openaq.org/register
OPENAQ_API_KEY=
# ReliefWeb – pre-approved app name: https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=
# HDX Humanitarian API – app identifier = base64("app-name:email"), see https://hdx-hapi.readthedocs.io/
HDX_APP_IDENTIFIER=
# Cloudflare Radar outage annotations – API token with Account → Radar → Read: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
# ACLED (opt-in, also add "acled" to WIM_ENABLED_SOURCES) – myACLED account. Private, non-public instances only.
ACLED_EMAIL=
ACLED_PASSWORD=
# OpenSky (opt-in, also add "opensky" to WIM_ENABLED_SOURCES) – optional OAuth2 client for a higher quota.
# Non-profit research/education use only; a written agreement is required for operational use.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# PeeringDB – optional API key for higher rate limits
PEERINGDB_API_KEY=
# Optional identifiers sent to providers that ask clients to identify themselves (not secrets)
# DIGITRAFFIC_USER=MyOrg/WorldMap 1.0
# RIPESTAT_SOURCEAPP=my-org-world-map

# ── Fixture / demo mode only ──────────────────────────────────────────────────────────────────────────
# on = scripted outages, rate limits, malformed payloads and recovery · static = only stale + unconfigured · off
# WIM_DEMO_SCENARIO=on
# Number of generated high-volume fire detections (0 disables)
# WIM_DEMO_VOLUME=45000
# Seconds the stale-data demonstration source stays un-refreshed after start-up
# WIM_DEMO_STALE_HOLD_SEC=240
