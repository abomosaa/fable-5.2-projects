# Apex Drift server configuration. Every value is optional; defaults are shown.
# Copy to .env and export, or set these in your process manager / container.

# development | production | test. Production binds 0.0.0.0, requires an Origin
# header on WebSocket handshakes and only accepts same-origin or listed origins.
NODE_ENV=production

# Interface and port to listen on.
HOST=0.0.0.0
PORT=8080

# Public URL of the site (its origin is always allowed to connect).
PUBLIC_URL=https://race.example.com
# WebSocket URL handed to browsers via /config.json. Leave empty when the game
# server serves the client itself (the client then uses wss://<same host>/ws).
WS_PUBLIC_URL=
# Extra origins allowed to open WebSockets, comma separated. "*" allows any.
ALLOWED_ORIGINS=
# Accept WebSocket handshakes without an Origin header (non-browser clients).
ALLOW_MISSING_ORIGIN=false
# Set to true only behind a reverse proxy you control: trusts X-Forwarded-For
# (client address for rate limits) and X-Forwarded-Host (same-origin check).
TRUST_PROXY=false

# Free-form label shown on room cards.
REGION=
# Directory with the built client. Defaults to dist/client next to the server.
STATIC_DIR=
# Directory for persisted lap records. Defaults to ./data.
DATA_DIR=
LOG_LEVEL=info

# Simulation.
TICK_RATE=60
SNAPSHOT_EVERY=2
FINISH_TIMEOUT_S=60
RESULTS_HOLD_S=40

# Capacity and abuse limits.
MAX_CONNECTIONS=500
MAX_CONNECTIONS_PER_IP=16
MAX_ROOMS=100
MAX_ROOMS_PER_IP=6
CREATE_BURST=5
CREATE_PER_MINUTE=6
JOIN_BURST=15
JOIN_PER_MINUTE=40
CONNECT_BURST=40
CONNECT_PER_MINUTE=120

# Lifetimes.
RECONNECT_GRACE_S=30
ROOM_IDLE_TIMEOUT_S=900
KICK_BAN_S=120
HELLO_TIMEOUT_S=10
HEARTBEAT_INTERVAL_S=5
CONNECTION_TIMEOUT_S=30
