# Cutline configuration. Copy to `.env` (or `.env.local`) and fill in what you need.
# Nothing in this file is ever sent to the browser: all keys stay on the server.

# --- Speech (transcript-based editing) ------------------------------------------
# Soniox API key for live transcription (https://console.soniox.com).
# Leave empty to run without transcription, or start the server with `--fixture`
# to use deterministic, clearly labelled fixture transcripts instead.
SONIOX_API_KEY=
# Async model. `stt-async-v5` is the default.
# SONIOX_MODEL=stt-async-v5
# SONIOX_BASE_URL=https://api.soniox.com

# --- Editing assistant (Pi SDK sidecar, live mode only) --------------------------
# The assistant runs through the Pi SDK (@mariozechner/pi-agent-core) in `sidecar/`.
# Install it once with `npm ci --prefix sidecar`, then provide a key for the
# provider you want to use. Fixture mode needs none of this.
# PI_PROVIDER=anthropic
# PI_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Server ---------------------------------------------------------------------
# CUTLINE_HOST=127.0.0.1
# CUTLINE_PORT=4310
# CUTLINE_DATA_DIR=./data
# Deterministic fixture mode (same as the `--fixture` flag).
# CUTLINE_FIXTURE=1
# Paths to FFmpeg tools when they are not on PATH (FFmpeg 6.1 or newer).
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe
# Largest accepted upload, in GB.
# CUTLINE_MAX_UPLOAD_GB=64
